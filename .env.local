# ========================================
# FRONTEND ENVIRONMENT VARIABLES
# ========================================

# FastAPI Backend URL
# Change this to your production backend URL for deployment
# Example: https://your-backend-domain.com
NEXT_PUBLIC_FASTAPI_BASE_URL=http://192.168.100.200:8000

# File Upload Size Limits (in MB)
# Maximum file size for general uploads (non-PDF files)
NEXT_PUBLIC_MAX_FILE_SIZE_MB=50

# Maximum file size specifically for PDF files
NEXT_PUBLIC_MAX_PDF_SIZE_MB=2